+/* mkstemp into TMPDIR; returns an open fd and writes the path to pathOut.
+   Not unlinked here -- Windows cannot unlink an open file; the caller
+   unlinks once no handle remains. */
+static int unpin_mkstemp(char *pathOut, size_t cap) {
+    const char *t = getenv("TMPDIR");
+    if (!t || !*t) t = getenv("TEMP");
+    if (!t || !*t) t = "/tmp";
+    snprintf(pathOut, cap, "%s/unpinxkbXXXXXX", t);
+    return mkstemp(pathOut);
+}
