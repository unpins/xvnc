+/* Anonymous, seekable, fork-inheritable fd: a kernel memfd. Plain flags
+   (not CLOEXEC) so the fork inherits it; no execve, so nothing leaks. */
+static int unpin_anon_fd(const char *tag) {
+    return (int) syscall(SYS_memfd_create, tag, 0u);
